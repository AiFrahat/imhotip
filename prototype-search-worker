:root{font-family:Tahoma,"Segoe UI",sans-serif;color:#172033;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}main{width:min(900px,calc(100% - 32px));margin:40px auto;background:#fff;border:1px solid #dfe5ef;border-radius:18px;padding:28px;box-shadow:0 12px 40px #1e3a5f12}.eyebrow{font:12px Arial;color:#2364d2;letter-spacing:1px}h1{margin:.4rem 0}#status,#timing{color:#5d687a}label{display:grid;gap:8px;font-weight:700;margin:24px 0}input{height:54px;border:1px solid #ccd5e2;border-radius:12px;padding:0 16px;font:16px inherit;direction:ltr}input:focus{outline:3px solid #2364d229;border-color:#2364d2}#results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}article{display:grid;gap:4px;border:1px solid #e2e7ef;border-radius:12px;padding:14px}article span{color:#526074;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}article small{color:#2364d2}@media(max-width:600px){main{margin:16px auto;padding:18px}#results{grid-template-columns:1fr}}
